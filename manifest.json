{
  "manifest_version": 3,
  "name": "Jev Investment Forecast",
  "version": "1.0",
  "description": "Inspects the current page with TypeSafe Jev AI and forecasts its investment potential with a percentage score for every category (fraud, ads, spam…).",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jev Investment Forecast"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}

